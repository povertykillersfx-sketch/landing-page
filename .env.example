# Public site URL used for Open Graph metadata.
SITE_URL=http://localhost:3000

# SQLite file. The directory is created automatically.
DATABASE_PATH=./data/pkfx.sqlite

# Admin dashboard login. Use a long, unique password.
# You can set ADMIN_PASSWORD_HASH (bcrypt) instead of ADMIN_PASSWORD.
ADMIN_EMAIL=admin@povertykillersfx.com
ADMIN_PASSWORD=change-me-to-a-long-password

# At least 32 characters. Used to sign admin sessions and booking tokens.
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars

# Optional overrides. If set, these replace the values in src/config/site.ts.
# CALENDLY_URL=https://calendly.com/povertykillersfx/pkfx-ai-market-scanner-course
# TELEGRAM_URL=https://t.me/povertykillersfx
# VSL_VIDEO_URL=https://www.youtube.com/watch?v=VIDEO_ID
# LOGO_URL=https://example.com/logo.svg
# Calendly webhook signing key. Leave unset until you create a webhook.
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Optional analytics. Leave blank to disable the vendor scripts.
# GA_MEASUREMENT_ID=G-XXXXXXXX
# META_PIXEL_ID=1234567890
